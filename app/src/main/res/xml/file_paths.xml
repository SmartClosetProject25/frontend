<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- createImageUri で context.cacheDir を使っているなら -->
    <cache-path
        name="images"
        path="." />

    <!-- もし filesDir を使う場合はこっちも追加してOK   -->
    <files-path
        name="internal_images"
        path="." />

    <!-- カメラ撮影用の外部ファイルディレクトリ -->
    <external-files-path
        name="external_images"
        path="." />

</paths>
